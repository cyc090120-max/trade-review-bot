<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8">
<style>
  :root{--bg:#131722;--panel:#1b1f2b;--line:#2a2e39;--text:#e1e3ea;--muted:#8b8fa0;
        --up:#26a69a;--down:#ef5350;--good:#26a69a;--mid:#f0a73a;--bad:#ef5350}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);width:{{ width }}px;
       font-family:"PingFang SC","Noto Sans CJK SC","Noto Sans SC","Microsoft YaHei",sans-serif}
  .head{padding:20px 24px 10px}
  .head h1{margin:0;font-size:28px;font-weight:600;line-height:1.35}
  .head .sub{color:var(--muted);font-size:18px;margin-top:4px;font-variant-numeric:tabular-nums}
  .head .sub b{font-weight:600}
  .up{color:var(--up)} .down{color:var(--down)}
  #wrap{position:relative;width:{{ width }}px;height:{{ chart_height }}px}
  #chart{position:absolute;inset:0}
  #ov{position:absolute;left:0;top:0;pointer-events:none;z-index:20}
  #ov svg{position:absolute;left:0;top:0;overflow:visible}
  .list{padding:8px 24px 22px}
  .item{display:flex;gap:12px;padding:14px 0;border-top:1px solid var(--line)}
  .item .num{font-size:28px;line-height:1.3;flex:none;width:34px}
  .item .meta{color:var(--muted);font-size:19px;font-variant-numeric:tabular-nums}
  .item .meta strong{color:var(--text);font-weight:600;margin-right:8px}
  .item .tag{font-size:23px;font-weight:600;margin:4px 0 2px}
  .item .cm{font-size:21px;line-height:1.6}
  .item .after{font-size:18px;line-height:1.55;color:var(--muted);margin-top:6px}
  .v{display:inline-block;border-radius:5px;padding:0 8px;margin-right:8px;font-size:18px;font-weight:600;vertical-align:2px}
  .v.good{background:rgba(38,166,154,.2);color:var(--good)}
  .v.mid{background:rgba(240,167,58,.2);color:var(--mid)}
  .v.bad{background:rgba(239,83,80,.2);color:var(--bad)}
</style></head>
<body>
<div class="head">
  <h1>{{ title }}</h1>
  <div class="sub">{{ sub|safe }}</div>
</div>
<div id="wrap"><div id="chart"></div><div id="ov"><svg id="svg"></svg></div></div>

{% if items %}
<div class="list">
  {% for it in items %}
  <div class="item">
    <div class="num">{{ it.label }}</div>
    <div>
      <div class="meta"><strong>{{ it.time }} {{ it.title }}</strong>{{ it.action }}</div>
      <div class="tag"><span class="v {{ it.vclass }}">{{ it.verdict }}</span>{{ it.tag }}</div>
      <div class="cm">{{ it.comment }}</div>
      {% if it.hindsight %}<div class="after">事后：{{ it.hindsight }}</div>{% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

<script src="{{ lib_uri }}"></script>
<script>
const BARS = {{ bars_json|safe }};
const VWAP = {{ vwap_json|safe }};
const LEVELS = {{ levels_json|safe }};
const SCALE_EXTRA = {{ scale_extra_json|safe }};
const MARKERS = {{ markers_json|safe }};
const W = {{ width }}, H = {{ chart_height }};
const C = {bg:'#131722', grid:'#1e222d', text:'#d1d4dc', border:'#2a2e39', up:'#26a69a', down:'#ef5350',
           buy:'#2962ff', sell:'#ff9800', good:'#26a69a', mid:'#f0a73a', bad:'#ef5350', vwap:'#e0e0e0'};
const LC = LightweightCharts;

const chart = LC.createChart(document.getElementById('chart'), {
  width: W, height: H,
  layout: {background: {color: C.bg}, textColor: C.text, fontSize: 15},
  grid: {vertLines: {color: C.grid}, horzLines: {color: C.grid}},
  timeScale: {timeVisible: true, secondsVisible: false, borderColor: C.border, rightOffset: 2},
  rightPriceScale: {borderColor: C.border, scaleMargins: {top: 0.1, bottom: 0.1}},
  crosshair: {vertLine: {visible: false}, horzLine: {visible: false}},
});
const series = chart.addSeries(LC.CandlestickSeries, {
  upColor: C.up, downColor: C.down, borderVisible: false, wickUpColor: C.up, wickDownColor: C.down,
  lastValueVisible: false, priceLineVisible: false,
  autoscaleInfoProvider: (orig) => {
    const r = orig();
    if (!r) return r;
    for (const p of SCALE_EXTRA) {
      r.priceRange.minValue = Math.min(r.priceRange.minValue, p);
      r.priceRange.maxValue = Math.max(r.priceRange.maxValue, p);
    }
    return r;
  },
});
series.setData(BARS);
if (VWAP.length) {
  const vw = chart.addSeries(LC.LineSeries, {color: C.vwap, lineWidth: 2, lineStyle: 0, lastValueVisible: false,
                                             priceLineVisible: false, crosshairMarkerVisible: false, title: 'VWAP'});
  vw.setData(VWAP);
}
for (const l of LEVELS) {
  series.createPriceLine({price: l.price, color: l.color, lineWidth: l.width, lineStyle: 2, axisLabelVisible: true, title: l.name});
}
chart.timeScale().fitContent();

function draw() {
  const paneW = W - chart.priceScale('right').width();
  const paneH = H - chart.timeScale().height();
  const ov = document.getElementById('ov');
  const svg = document.getElementById('svg');
  ov.style.width = paneW + 'px'; ov.style.height = paneH + 'px';
  svg.setAttribute('width', paneW); svg.setAttribute('height', paneH);
  const NS = 'http://www.w3.org/2000/svg';
  const el = (tag, attrs) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); svg.appendChild(e); return e; };

  // each fill: a dot at the exact price, a numbered badge just above (sells) or below (buys) its candle
  const placed = [];
  const R = 15;
  const free = (x, y) => placed.every(p => Math.hypot(p.x - x, p.y - y) > 2 * R + 3) && y > R + 2 && y < paneH - R - 2;
  const top = (t) => { const b = BARS.find(b => b.time === t); return b ? series.priceToCoordinate(b.high) : null; };
  const bot = (t) => { const b = BARS.find(b => b.time === t); return b ? series.priceToCoordinate(b.low) : null; };
  for (const m of MARKERS) {
    const x = chart.timeScale().timeToCoordinate(m.bar_time), y = series.priceToCoordinate(m.price);
    if (x === null || y === null) continue;
    placed.push({x, y});
  }
  for (const m of MARKERS) {
    const x = chart.timeScale().timeToCoordinate(m.bar_time), y = series.priceToCoordinate(m.price);
    if (x === null || y === null) continue;
    const color = m.verdict_class ? C[m.verdict_class] : (m.is_buy ? C.buy : C.sell);
    let dir = m.is_buy ? 1 : -1;
    const edge = (d) => d < 0 ? Math.min(top(m.bar_time) ?? y, y) : Math.max(bot(m.bar_time) ?? y, y);
    let by = null, bx = x;
    for (const d of [dir, -dir]) {
      for (let k = 0; k < 10 && by === null; k++) {
        const cy = edge(d) + d * (R + 14 + k * (2 * R + 4));
        for (const dx of [0, -R * 1.6, R * 1.6]) if (by === null && free(x + dx, cy)) { by = cy; bx = x + dx; dir = d; }
      }
      if (by !== null) break;
    }
    if (by === null) { by = Math.min(Math.max(y + dir * 40, R + 2), paneH - R - 2); }
    placed.push({x: bx, y: by});
    el('line', {x1: bx, y1: by - dir * R, x2: x, y2: y, stroke: color, 'stroke-width': 2, 'stroke-dasharray': '3 3'});
    el('circle', {cx: x, cy: y, r: 5.5, fill: m.is_buy ? C.buy : C.sell, stroke: '#fff', 'stroke-width': 1.5});
    el('circle', {cx: bx, cy: by, r: R, fill: '#131722', stroke: color, 'stroke-width': 2.5});
    const t = el('text', {x: bx, y: by + 6, 'text-anchor': 'middle', fill: '#fff', 'font-size': 17, 'font-weight': 700});
    t.textContent = m.n;
  }
  window.__ready = true;
}
requestAnimationFrame(() => requestAnimationFrame(draw));
</script>
</body></html>
